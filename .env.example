# Storovex environment variables.
# Copy to .env.local and fill in. NEVER commit a filled-in copy.
# Only NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application (required) ---
# Absolute origin, used for auth redirects and email links. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Billing: Paddle (required in production) ---
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# --- Email: Resend (required in production) ---
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=Storovex <notifications@storovex.com>

# --- AI providers (required in production; see Phase 2) ---
GEMINI_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# --- Tuning (optional) ---
# Internal cost proxy used by admin margin analytics.
CREDIT_COST_CENTS=4

# --- Job worker (required for AI generation to actually run) ---
# Shared secret for POST /api/jobs/process. Without it the worker refuses to run:
# an open endpoint that spends user credits is worse than a broken one.
CRON_SECRET=

# --- Model overrides (optional) ---
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
CEREBRAS_MODEL=llama-3.3-70b
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
ANTHROPIC_MODEL=claude-sonnet-5
